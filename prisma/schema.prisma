datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id              String    @id @default(uuid())
  platform        String    // "TWITTER" atau "TELEGRAM"
  externalId      String    @unique // Twitter User ID / Chat ID
  status          String    @default("POTENTIAL") // POTENTIAL, CONTACTED, IGNORED
  lastContactedAt DateTime?
  interactions    Interaction[]
}

model Interaction {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  contextText String   @db.Text // Pesan pemicu
  aiResponse  String   @db.Text // Jawaban AI
  createdAt   DateTime @default(now())
}
